# URL base de la API NestJS (backend_bar).
# Incluye el prefijo global /api que define app.setup.ts -> setGlobalPrefix('api').
# El backend escucha en PORT=3001 y su CORS_ORIGIN apunta a http://localhost:3000.
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Solo para `npm run bones`: JWT temporal de SUPERADMIN. No guardar tokens
# reales en Git; exportar BONEYARD_ACCESS_TOKEN en la terminal que ejecuta CLI.
# BONEYARD_ACCESS_TOKEN=""
